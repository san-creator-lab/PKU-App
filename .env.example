# Supabase project keys. Leave unset to run the app in keyless local demo
# mode (IndexedDB + BroadcastChannel — single-device, no account needed).
# Fill these to run against a real Supabase project (hosted or `supabase start`):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# OCR provider: "tesseract" (default, client-side, no keys) or "anthropic"
# (calls the ocr-label Edge Function; requires the function to be deployed
# and ANTHROPIC_API_KEY set as a Supabase secret — see README).
VITE_OCR_PROVIDER=tesseract
